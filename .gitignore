# ========================
# Dependencies
# ========================
# No leading slash means it ignores node_modules in both /client and /server
node_modules/
.pnp/
.pnp.js

# ========================
# Environment Variables
# ========================
# Ignores all .env files across both /client and /server
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Explicitly KEEP .env.example files in both folders
!.env.example

# ========================
# Next.js Build (Client)
# ========================
# Specifically targets the Next.js outputs inside the client folder
client/.next/
client/out/
client/build/

# ========================
# Debug Logs
# ========================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ========================
# OS & Editor Files
# ========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs and Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


spec.md